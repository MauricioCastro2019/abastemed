# ============================================================
# ABASTEMED — Variables de entorno
# Copiar este archivo a .env.local y completar los valores
# NUNCA subir .env.local a git
# ============================================================

# Supabase — Obtenidas en: Settings > API en tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Solo para operaciones server-side que requieren permisos elevados
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# URL base de la app (para redirects de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
